rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isOrganizer() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "organizer";
    }

    match /users/{uid} {
      // Users can only access their own profile. Organizers can read.
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && isOrganizer();
    }

    match /teams/{teamId} {
      // Any authenticated user can create a team initially
      allow create: if request.auth != null;
      
      // Read/Update allowed if it's their team, or they are an organizer
      allow read, update: if request.auth != null && (
        isOrganizer() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId == teamId)
      );
      
      allow delete: if request.auth != null && isOrganizer();
    }
  }
}